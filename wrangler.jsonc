{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "klyde-art-portfolio",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-21",
  "kv_namespaces": [
    {
      "binding": "PORTFOLIO_CONFIG",
      "id": "0d513248eb1641278e90510ed953fe4b"
    }
  ]
  // Media library storage. Declaring an r2_buckets binding here fails the
  // Pages build until the bucket actually exists, so the binding is added in
  // the dashboard instead (Settings -> Bindings -> R2, name PORTFOLIO_MEDIA).
  // Until it is bound the media endpoints answer 503 'r2-unbound' naming the
  // binding to create, and nothing else on the site is affected. Once the
  // bucket exists this can be uncommented to keep the config declarative:
  //
  // "r2_buckets": [
  //   { "binding": "PORTFOLIO_MEDIA", "bucket_name": "klyde-art-portfolio-media" }
  // ]
}
